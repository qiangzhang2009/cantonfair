# ============================================================
# Supabase 配置
# ============================================================
# 项目 URL (在 Supabase Dashboard → Settings → API 中找到)
SUPABASE_URL=https://xxxx.supabase.co

# 公开密钥 (anon public) — 用于客户端，只读权限
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 服务端密钥 (service_role) — 仅用于数据导入脚本，勿暴露在前端
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# Cloudflare R2 配置 (可选，保留原有用法)
# ============================================================
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=cantonfair-data
# R2_PUBLIC_URL=

# ============================================================
# 数据文件路径 (本地开发用)
# ============================================================
# DATA_FILE_PATH=/path/to/广交会数据综合整理_标准格式.xlsx
