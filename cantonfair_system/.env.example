# ============================================================
# CantonFair Pro — 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# ============================================================

# ---------- 云存储配置 (Cloudflare R2) ----------
# 前往 https://dash.cloudflare.com/r2 创建存储桶和 API Token
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=cantonfair-data
R2_DATA_FILE_KEY=广交会数据综合整理_标准格式.xlsx
# R2 公共访问域名（绑定自定义域名后可填，否则留空）
R2_PUBLIC_URL=https://your-account.r2.dev

# ---------- 应用配置 ----------
APP_NAME=CantonFair Pro
APP_VERSION=1.0.0
# 本地数据文件路径（本地开发模式使用，优先级高于 R2）
LOCAL_DATA_FILE=../广交会数据综合整理_标准格式.xlsx

# ---------- 登录认证 ----------
# 生成密钥命令: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_64_char_hex_string
# 支持多用户，格式: 用户名:密码（bcrypt hash），用逗号分隔
# 生成 bcrypt hash: pip install bcrypt && python3 -c "import bcrypt; print(bcrypt.hashpw(b'password', bcrypt.gensalt()).decode())"
AUTH_USERS=admin:$2b$12$your_bcrypt_hash_here

# ---------- 邮件配置 (可选，用于发送通知) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# ---------- 进化引擎数据路径 ----------
EVOLUTION_DATA_FILE=evolution_data.json
OUTREACH_DATA_FILE=outreach_data.json

# ---------- 日志 ----------
LOG_LEVEL=INFO
